{
  "name": "electron-app-vitals",
  "version": "0.2.0",
  "description": "Zero-overhead, Rust-powered Core Desktop Vitals for Electron and native applications (TTFP, EST, IRL, MBR, FDC)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "prebuilds/*.node",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:native": "node scripts/build-native.cjs",
    "build:ts": "tsc && node -e \"require('fs').copyFileSync('src/native-loader.cjs','dist/native-loader.cjs')\"",
    "build": "npm run build:native && npm run build:ts",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "electron",
    "desktop",
    "vitals",
    "web-vitals",
    "performance",
    "rust",
    "telemetry",
    "stall-detection",
    "ipc",
    "mcp"
  ],
  "author": "Rudra Pratap Singh",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudraptpsingh/app-vitals.git"
  },
  "engines": {
    "node": ">=18"
  }
}
